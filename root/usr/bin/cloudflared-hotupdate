#!/bin/sh
# cloudflared-hotupdate
# Refresh / regenerate tunnel configuration without reinstalling.

set -u

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { printf "${GREEN}[INFO]${NC} %s\n" "$1"; }
warn()  { printf "${YELLOW}[WARN]${NC} %s\n" "$1"; }
error() { printf "${RED}[ERROR]${NC} %s\n" "$1"; exit 1; }
step()  { printf "\n${CYAN}===== %s =====${NC}\n" "$1"; }

CTL="/usr/bin/cloudflared-ctl"
COMMON="${CLOUDFLARED_COMMON:-/usr/lib/cloudflared/common.sh}"
[ -f "$COMMON" ] || {
	printf 'missing common library: %s\n' "$COMMON" >&2
	exit 1
}
. "$COMMON"

usage() {
	cat <<'USAGE'
Usage:
  cloudflared-hotupdate [options]

Options:
  -t, --tunnel <section>    Tunnel section to operate on (default: default)
  -d, --domain <domain>     Switch root domain and rewrite ingress hostnames
  -b, --base-path <path>    Override cloudflared base path
      --reauth              Re-run cloudflared login and refresh cert.pem
      --no-rewrite-hosts    Keep ingress hostnames unchanged when switching domain
      --no-dns-sync         Skip cloudflared route dns
      --no-restart          Do not restart /etc/init.d/cloudflared
  -h, --help                Show this help

Default behavior:
  1) Regenerate config.yml for the selected tunnel
  2) Sync missing DNS records
  3) Restart the service

With --domain:
  1) Rewrite ingress hostnames from the old domain to the new one
  2) Update UCI domain / applied_domain
  3) Regenerate config.yml, sync DNS, restart

With --reauth:
  Remove/backup the current cert, run cloudflared login interactively,
  then copy the new cert.pem into the tunnel directory.
USAGE
}

SECTION="default"
NEW_DOMAIN=""
BASE_PATH=""
REAUTH=0
NO_REWRITE_HOSTS=0
NO_DNS_SYNC=0
NO_RESTART=0

while [ $# -gt 0 ]; do
	case "$1" in
		-t|--tunnel)
			shift
			[ $# -gt 0 ] || error "--tunnel requires a value"
			SECTION="$1"
			;;
		-d|--domain)
			shift
			[ $# -gt 0 ] || error "--domain requires a value"
			NEW_DOMAIN="$1"
			;;
		-b|--base-path)
			shift
			[ $# -gt 0 ] || error "--base-path requires a value"
			BASE_PATH="$1"
			;;
		--reauth)
			REAUTH=1
			;;
		--no-rewrite-hosts)
			NO_REWRITE_HOSTS=1
			;;
		--no-dns-sync)
			NO_DNS_SYNC=1
			;;
		--no-restart)
			NO_RESTART=1
			;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			error "Unknown option: $1 (use --help)"
			;;
	esac
	shift
done

cf_require_root

[ -x "$CTL" ] || error "cloudflared-ctl not found"

if [ -n "$BASE_PATH" ]; then
	uci -q set cloudflared.main.base_path="$BASE_PATH"
	uci -q commit cloudflared
fi

if [ -z "$(uci -q get "cloudflared.$SECTION" 2>/dev/null)" ]; then
	error "Tunnel section '$SECTION' not found. Open LuCI once to run the config migration, or create the tunnel first."
fi

if [ -n "$NEW_DOMAIN" ] && ! cf_valid_domain "$NEW_DOMAIN"; then
	error "Invalid domain: $NEW_DOMAIN"
fi

if [ "$REAUTH" -eq 1 ]; then
	step "Re-authorization"
	BIN="$(cf_find_binary)" || error "cloudflared binary not found"
	CERT_PATH="$(cf_cert_path "$SECTION")"
	DIR="$(cf_tunnel_dir "$SECTION")"

	if [ -f "$CERT_PATH" ]; then
		cp -f "$CERT_PATH" "$CERT_PATH.bak.$(date +%s)" 2>/dev/null || true
		info "Backed up existing cert: $CERT_PATH"
	fi

	info "Running cloudflared login (open the URL in a browser and authorize)"
	"$BIN" login || error "cloudflared login failed"

	SRC_CERT=""
	for p in "${HOME:-/root}/.cloudflared/cert.pem" "/root/.cloudflared/cert.pem"; do
		if [ -f "$p" ]; then
			SRC_CERT="$p"
			break
		fi
	done
	[ -n "$SRC_CERT" ] || error "cert.pem not found after login"

	mkdir -p "$DIR"
	cp -f "$SRC_CERT" "$CERT_PATH"
	chmod 600 "$CERT_PATH" 2>/dev/null || true
	uci -q set "cloudflared.$SECTION.cert_path=$CERT_PATH"
	uci -q commit cloudflared
	info "Certificate ready: $CERT_PATH"
fi

if [ -n "$NEW_DOMAIN" ]; then
	step "Switch domain"
	set -- domain-switch "$SECTION" "$NEW_DOMAIN"
	[ "$NO_REWRITE_HOSTS" -eq 1 ] && set -- "$@" --no-rewrite-hosts
	[ "$NO_DNS_SYNC" -eq 1 ] && set -- "$@" --no-dns-sync
	[ "$NO_RESTART" -eq 1 ] && set -- "$@" --no-restart
	"$CTL" "$@" || error "Domain switch failed"
else
	step "Regenerate config.yml"
	"$CTL" gen-config "$SECTION" || error "Failed to generate config"

	if [ "$NO_DNS_SYNC" -eq 0 ]; then
		step "Sync DNS"
		"$CTL" dns-sync "$SECTION" || warn "DNS sync reported an error"
	else
		warn "DNS sync skipped"
	fi

	if [ "$NO_RESTART" -eq 0 ]; then
		step "Restart service"
		if /etc/init.d/cloudflared restart >/dev/null 2>&1; then
			info "Service restarted"
		else
			warn "Service restart failed, please check /etc/init.d/cloudflared status"
		fi
	else
		warn "Service restart skipped"
	fi
fi

step "Done"
info "Tunnel: $SECTION"
info "Config: $(cf_config_path "$SECTION")"
info "Cert:   $(cf_cert_path "$SECTION")"
