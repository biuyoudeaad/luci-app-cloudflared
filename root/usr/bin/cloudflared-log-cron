#!/bin/sh
# Synchronize the scheduled log-cleanup crontab entry from UCI.
. /usr/lib/cloudflared/common.sh

CRON_FILE="/etc/crontabs/root"
CLEAR_MARK="#cloudflared-log-clear"
LEGACY_ROTATE_MARK="#cloudflared-log-rotate"

mkdir -p /etc/crontabs 2>/dev/null
touch "$CRON_FILE" 2>/dev/null
sed -i "/$CLEAR_MARK/d" "$CRON_FILE" 2>/dev/null
# Remove the old 5-minute rotation entry installed by earlier releases.
sed -i "/$LEGACY_ROTATE_MARK/d" "$CRON_FILE" 2>/dev/null

enabled="$(cf_get log scheduled_clear 1)"
expr="$(cf_get log scheduled_clear_cron '*/5 * * * *')"

lines="$(printf '%s' "$expr" | wc -l | tr -d ' ')"
if [ "$lines" -gt 0 ]; then
	cf_log "WARN: rejected multi-line cron expression"
	expr=""
fi

if [ -n "$expr" ]; then
	if ! printf '%s' "$expr" | grep -Eq '^[0-9*/,-]+([[:space:]]+[0-9*/,-]+){4}$'; then
		cf_log "WARN: rejected invalid cron expression: $expr"
		expr=""
	fi
fi

if [ "$enabled" = "1" ] && [ -n "$expr" ]; then
	printf '%s /usr/bin/cloudflared-ctl scheduled-clean %s\n' "$expr" "$CLEAR_MARK" >> "$CRON_FILE"
fi

[ -x /etc/init.d/cron ] && /etc/init.d/cron restart >/dev/null 2>&1
exit 0
