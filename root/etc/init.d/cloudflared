#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

. /usr/lib/cloudflared/common.sh

start_service() {
	local bin section

	mkdir -p "$CF_LOG_DIR" 2>/dev/null
	bin="$(cf_find_binary)" || {
		cf_log "ERROR: cloudflared binary not found"
		return 1
	}

	cf_log "Starting cloudflared service"
	for section in $(cf_tunnel_sections); do
		start_one "$section" "$bin" || true
	done

	/usr/bin/cloudflared-log-cron >/dev/null 2>&1 || true
}

start_one() {
	local section="$1"
	local bin="$2"
	local enabled cfg name

	enabled="$(cf_get "$section" enabled 1)"
	[ "$enabled" = "1" ] || return 0

	name="$(cf_get "$section" name)"
	cfg="$(cf_gen_config "$section")" || {
		cf_log "ERROR: failed to generate config for tunnel '${name:-$section}'"
		return 1
	}

	cf_log "Starting tunnel '${name:-$section}'"
	procd_open_instance "tunnel_$section"
	procd_set_param command /bin/sh -c 'exec "$0" --config "$1" tunnel run >> "$2" 2>&1' \
		"$bin" "$cfg" "$CF_CORE_LOG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	local clear

	cf_log "Stopping cloudflared service"
	clear="$(cf_get log clear_at_stop 0)"
	if [ "$clear" = "1" ]; then
		: > "$CF_APP_LOG" 2>/dev/null
		: > "$CF_CORE_LOG" 2>/dev/null
	fi
}
