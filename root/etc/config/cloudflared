config main 'main'
	option data_path '/etc/cloudflared'
	option cert_path '/etc/cloudflared/cert.pem'
	option config_version '2'
	option download_url 'https://github.com/cloudflare/cloudflared/releases/latest/download'
	option allow_dns_delete '0'

config log 'log'
	option scheduled_clear '1'
	option scheduled_clear_cron '*/5 * * * *'
	option log_max_size '1'
	option log_max_unit 'MB'
	option clear_at_stop '1'
